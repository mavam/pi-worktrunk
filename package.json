{
  "name": "pi-worktrunk",
  "version": "0.7.0",
  "description": "Worktrunk commands, session placement, status, and agent tools for pi",
  "type": "module",
  "files": [
    "worktrunk.ts",
    "worktrunk-reference.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "worktrunk",
    "git-worktree",
    "status",
    "commands",
    "agent-tools",
    "session-placement"
  ],
  "author": "Matthias Vallentin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-worktrunk.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "check": "tsc --noEmit && node --test --experimental-strip-types *.test.ts scripts/*.test.ts && bun run check-reference",
    "check-reference": "node --experimental-strip-types scripts/generate-worktrunk-reference.ts --check",
    "generate-reference": "node --experimental-strip-types scripts/generate-worktrunk-reference.ts",
    "test": "node --test --experimental-strip-types *.test.ts scripts/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./worktrunk.ts"
    ]
  }
}
